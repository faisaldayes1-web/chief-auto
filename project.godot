; Engine configuration file.
config_version=5

[application]

config/name="Chief Auto: Dealership Simulator"
config/description="Run OC Chief Auto: bid, repair, sell, grow."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/version="0.9.0-beta"
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game_state.gd"
SteamBridge="*res://scripts/steam_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor]

; Godot 4.3's threaded importer segfaulted intermittently on headless imports of this project (4 of ~30 runs on
; desktop1, 2026-10-21/22, always while several textures re-imported in parallel). Serial import is slower but
; deterministic. tools/godot_import.py also retries a crashed import.
import/use_multiple_threads=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

reflections/reflection_atlas/reflection_count=4

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
